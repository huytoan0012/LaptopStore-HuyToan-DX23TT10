@model LaptopStore.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ - LaptopStore";
}

<div class="hero-section text-center py-5 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px;">
    <div class="container">
        <h1 class="display-4 fw-bold">Chào mừng đến với LaptopStore</h1>
        <p class="lead">Nơi cung cấp những chiếc laptop chất lượng nhất</p>
        <a href="#" class="btn btn-light btn-lg mt-3">Khám phá ngay</a>
    </div>
</div>

<div class="container">
    <section class="brands-section mb-5">
        <h2 class="text-center mb-4">Thương hiệu nổi bật</h2>
        <div class="row justify-content-center">
            @foreach (var brand in Model.Brands)
            {
                <div class="col-6 col-md-2 text-center mb-3">
                    <div class="brand-card p-3 border rounded shadow-sm">
                        <div class="brand-name fw-bold">@brand.Name</div>
                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                        {
                            <img src="@brand.LogoUrl" alt="@brand.Name" class="img-fluid" style="max-height: 50px;" />
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="featured-products mb-5">
        <h2 class="text-center mb-4">⭐ Sản phẩm nổi bật</h2>
        <div class="row">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm product-card" style="cursor: pointer;">
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.jpg" : product.ImageUrl)" 
                             class="card-img-top" alt="@product.Name" 
                             style="height: 200px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title text-truncate">@product.Name</h5>
                            <p class="card-text text-muted small">@product.Brand?.Name</p>
                            <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") đ</p>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">Còn @product.StockQuantity sp</span>
                                    <a href="/Products/Details/@product.Id" class="btn btn-primary btn-sm">Xem chi tiết</a>
                                </div>
                                <form asp-action="AddToCart" asp-controller="Cart" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="latest-products">
        <h2 class="text-center mb-4">🔥 Sản phẩm mới nhất</h2>
        <div class="row">
            @foreach (var product in Model.LatestProducts)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm product-card" style="cursor: pointer;">
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.jpg" : product.ImageUrl)" 
                             class="card-img-top" alt="@product.Name" 
                             style="height: 200px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title text-truncate">@product.Name</h5>
                            <p class="card-text text-muted small">@product.Brand?.Name</p>
                            <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") đ</p>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">Còn @product.StockQuantity sp</span>
                                    <a href="/Products/Details/@product.Id" class="btn btn-primary btn-sm">Xem chi tiết</a>
                                </div>
                                <form asp-action="AddToCart" asp-controller="Cart" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.product-card').forEach(function(card) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('form') || e.target.closest('.btn-primary')) {
                    return;
                }
                var detailLink = this.querySelector('a.btn-primary');
                if (detailLink) {
                    window.location.href = detailLink.href;
                }
            });
        });
    });
</script>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
    .brand-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .brand-card:hover {
        background-color: #f8f9fa;
        transform: scale(1.05);
    }
    .hero-section {
        margin-top: -20px;
    }
</style>