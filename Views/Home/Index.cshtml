@model LaptopStore.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ - LaptopStore";
}

<style>
    /* ===== CONTAINER SẢN PHẨM ===== */
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
        border: none;
        background: white;
        height: 100%;
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.12) !important;
    }
    .product-card .card-img-top {
        height: 200px;
        object-fit: contain;
        padding: 15px;
        background: #f8f9fa;
        transition: transform 0.3s ease;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.02);
    }
    .product-card .card-body {
        padding: 16px;
    }
    .product-card .product-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1a1a2e;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 44px;
        margin-bottom: 4px;
    }
    .product-card .product-brand {
        font-size: 0.8rem;
        color: #888;
        margin-bottom: 8px;
    }
    .product-card .product-price {
        font-size: 1.15rem;
        font-weight: 700;
        color: #e74a3b;
        margin-bottom: 8px;
    }
    .product-card .product-price .old-price {
        font-size: 0.8rem;
        color: #adb5bd;
        text-decoration: line-through;
        font-weight: 400;
        margin-left: 8px;
    }
    .product-card .product-stock {
        font-size: 0.75rem;
        padding: 3px 10px;
        border-radius: 20px;
        background: #e8f5e9;
        color: #2e7d32;
    }
    .product-card .product-stock.low {
        background: #fff3e0;
        color: #e65100;
    }
    .product-card .product-stock.out {
        background: #fbe9e7;
        color: #c62828;
    }

    /* ===== CHIP THÔNG SỐ ===== */
    .spec-chip {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 500;
        padding: 4px 10px;
        border-radius: 20px;
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #e9ecef;
        margin-right: 4px;
        margin-bottom: 4px;
        transition: all 0.2s ease;
    }
    .spec-chip:hover {
        background: #e9ecef;
        transform: translateY(-1px);
    }
    .spec-chip i {
        margin-right: 3px;
        font-size: 0.6rem;
        color: #6c757d;
    }
    .spec-chip.cpu i { color: #4e73df; }
    .spec-chip.ram i { color: #1cc88a; }
    .spec-chip.storage i { color: #f6c23e; }
    .spec-chip.gpu i { color: #e74a3b; }
    .spec-chip.screen i { color: #36b9cc; }

    /* ===== NÚT ===== */
    .btn-detail {
        background: #4e73df;
        color: white;
        border: none;
        font-size: 0.8rem;
        padding: 5px 14px;
        border-radius: 6px;
        transition: background 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }
    .btn-detail:hover {
        background: #2e59d9;
        color: white;
    }
    .btn-add-cart {
        background: #1cc88a;
        color: white;
        border: none;
        font-size: 0.8rem;
        padding: 5px 14px;
        border-radius: 6px;
        transition: background 0.3s ease;
        width: 100%;
    }
    .btn-add-cart:hover {
        background: #17a673;
        color: white;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 576px) {
        .product-card .card-img-top {
            height: 160px;
        }
        .product-card .product-name {
            font-size: 0.85rem;
            min-height: 38px;
        }
        .spec-chip {
            font-size: 0.55rem;
            padding: 2px 8px;
        }
    }

    /* ===== HERO ===== */
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 50px 30px;
        margin-bottom: 40px;
        color: white;
    }
    .hero-section h1 {
        font-size: 2.5rem;
        font-weight: 700;
    }
    .hero-section .btn-hero {
        background: white;
        color: #667eea;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .hero-section .btn-hero:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    /* ===== BRAND ===== */
    .brand-card {
        padding: 15px;
        border-radius: 12px;
        background: white;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
        cursor: pointer;
        text-align: center;
    }
    .brand-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        border-color: #667eea;
    }
    .brand-card .brand-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a1a2e;
    }
</style>

<!-- ===== HERO ===== -->
<div class="hero-section text-center">
    <div class="container">
        <h1>🛒 Chào mừng đến với LaptopTTStore</h1>
        <p class="lead">Nơi cung cấp những chiếc laptop chất lượng nhất</p>
        <a href="#" class="btn-hero">Khám phá ngay</a>
    </div>
</div>
S
<!-- ===== THƯƠNG HIỆU ===== -->
<section class="brands-section mb-5">
    <h2 class="text-center mb-4">Thương hiệu nổi bật</h2>
    <div class="row justify-content-center">
        @foreach (var brand in Model.Brands)
        {
            <div class="col-6 col-md-2 text-center mb-3">
                <div class="brand-card p-3 border rounded shadow-sm" 
                     style="cursor: pointer; transition: all 0.3s ease;"
                     onclick="location.href='/Products?brandId=@brand.Id'">
                    <div class="brand-name fw-bold">@brand.Name</div>
                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                    {
                        <img src="@brand.LogoUrl" alt="@brand.Name" class="img-fluid" style="max-height: 50px; margin-top: 5px;" />
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- ===== SẢN PHẨM NỔI BẬT ===== -->
<section class="featured-products mb-5">
    <h2 class="text-center mb-4">⭐ Sản phẩm nổi bật</h2>
    <div class="row">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card product-card" onclick="location.href='/Products/Details/@product.Id'" style="cursor: pointer;">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.jpg" : product.ImageUrl)" 
                         class="card-img-top" alt="@product.Name" />
                    <div class="card-body">
                        <div class="product-name">@product.Name</div>
                        <div class="product-brand">@product.Brand?.Name</div>

                        <!-- CHIP THÔNG SỐ -->
                        <div class="mb-2">
                            @if (!string.IsNullOrEmpty(product.Specs))
                            {
                                var specs = product.Specs.Split('|');
                                @foreach (var spec in specs.Take(5))
                                {
                                    var specTrim = spec.Trim();
                                    <span class="spec-chip">
                                        <i class="fas fa-microchip"></i> @specTrim
                                    </span>
                                }
                            }
                        </div>

                        <div class="product-price">
                            @product.Price.ToString("N0") đ
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="product-stock">
                                <i class="fas fa-box"></i> Còn @product.StockQuantity sp
                            </span>
                            <a href="/Products/Details/@product.Id" class="btn-detail">
                                <i class="fas fa-eye"></i> Xem
                            </a>
                        </div>

                        <form asp-action="AddToCart" asp-controller="Cart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn-add-cart">
                                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ===== SẢN PHẨM MỚI NHẤT ===== -->
