<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaptopStore

</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .contact-item {
    padding: 10px 0;
    border-bottom: 1px solid #f1f1f1;
    display: flex;
    align-items: center;
    gap: 12px;
}
.contact-item:last-child {
    border-bottom: none;
}
.contact-item i {
    width: 30px;
    font-size: 1.2rem;
    text-align: center;
}
.contact-item a {
    color: #0d6efd;
    text-decoration: none;
}
.contact-item a:hover {
    text-decoration: underline;
}
        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        }
        .brand-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .brand-card:hover {
            background-color: #f8f9fa;
            transform: scale(1.05);
        }
        .hero-section {
            margin-top: -20px;
            border-radius: 15px;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: white !important;
        }
        .navbar-custom .nav-link:hover {
            color: rgba(255,255,255,0.8) !important;
        }
        footer {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            margin-top: 50px;
            padding: 30px 0;
        }
        footer a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
        }
        footer a:hover {
            color: white;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #5a6fd6 0%, #6a4292 100%);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-laptop"></i> LaptopTTStore


            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Products">Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                    <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#contactModal">
                        <i class="fas fa-phone-alt"></i> Liên hệ                       </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-success fw-bold" style="color: #90EE90 !important;">
                                <i class="fas fa-user-circle"></i> @User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                <i class="fas fa-shopping-cart"></i>
                                <span id="cartCount" class="badge bg-danger rounded-pill">0</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt"></i> Admin
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link border-0">
                                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Register" asp-controller="Account">
                                <i class="fas fa-user-plus"></i> Đăng ký
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Login" asp-controller="Account">
                                <i class="fas fa-sign-in-alt"></i> Đăng nhập
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container site-container mt-4">
        @RenderBody()
    </div>

    <footer class="mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="fas fa-laptop"></i> LaptopTTStore

</h5>
                    <p>Nơi cung cấp những chiếc laptop chất lượng nhất với giá cả hợp lý.</p>
                </div>
                <div class="col-md-4">
                    <h5>Liên kết</h5>
                    <ul class="list-unstyled">
                        <li><a href="/">Trang chủ</a></li>
                        <li><a href="/Products">Sản phẩm</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-map-marker-alt"></i> TP. Hồ Chí Minh</li>
                        <li><i class="fas fa-phone"></i> 0123 456 789</li>
                        <li><i class="fas fa-envelope"></i> info@LaptopTTStore.com</li>
                    </ul>
                </div>
            </div>
            <hr class="bg-light" />
            <p class="text-center mb-0">&copy; 2024 LaptopTTStore

 - All rights reserved.</p>
        </div>
    </footer>

    <div class="floating-actions" aria-label="Thao tác nhanh">
        <button type="button" id="scrollToTopButton" class="floating-action scroll-top-button" aria-label="Cuộn lên đầu trang" title="Cuộn lên đầu trang">
            <i class="fas fa-arrow-up"></i>
        </button>
        <a href="/Cart" class="floating-action cart-floating-button" aria-label="Mở giỏ hàng" title="Mở giỏ hàng">
            <i class="fas fa-shopping-cart"></i>
            <span id="floatingCartCount" class="floating-cart-count">0</span>
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    
    <script>
        function updateCartCount() {
            fetch('/Cart/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const cartBadge = document.getElementById('cartCount');
                    if (cartBadge) {
                        cartBadge.textContent = data.count;
                    }
                    const floatingCartBadge = document.getElementById('floatingCartCount');
                    if (floatingCartBadge) {
                        floatingCartBadge.textContent = data.count;
                    }
                })
                .catch(error => console.error('Lỗi cập nhật giỏ hàng:', error));
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();

            const scrollButton = document.getElementById('scrollToTopButton');
            window.addEventListener('scroll', function() {
                scrollButton.classList.toggle('is-visible', window.scrollY > 300);
            });

            scrollButton.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        document.addEventListener('submit', function(e) {
            if (e.target.action && e.target.action.includes('/Cart/AddToCart')) {
                setTimeout(updateCartCount, 500);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
        <!-- Modal Liên hệ -->
    <div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-headset"></i> Liên hệ với chúng tôi</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="contact-info">
                        <div class="contact-item">
                            <i class="fas fa-phone-alt text-success"></i>
                            <span><strong>Hotline:</strong> 0123 456 789</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope text-primary"></i>
                            <span><strong>Email:</strong> info@LaptopTTStore.com</span>
                        </div>
                        <div class="contact-item">
                            <i class="fab fa-facebook text-primary"></i>
                            <span><strong>Facebook:</strong> <a href="#" target="_blank">LaptopTTStore</a></span>
                        </div>
                        <div class="contact-item">
                            <i class="fab fa-zalo text-info"></i>
                            <span><strong>Zalo:</strong> <a href="#" target="_blank">0123 456 789</a></span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt text-danger"></i>
                            <span><strong>Địa chỉ:</strong> TP. Hồ Chí Minh</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Các script cũ giữ nguyên -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- ... -->
</body>
</html>