@model LaptopStore.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán";
    var cart = ViewBag.Cart as List<LaptopStore.Models.CartItem> ?? new List<LaptopStore.Models.CartItem>();
    var total = cart.Sum(c => c.Price * c.Quantity);
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-credit-card"></i> Thanh toán</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Thông tin nhận hàng</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Checkout" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="RecipientName" class="form-label fw-bold"></label>
                            <input asp-for="RecipientName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="RecipientName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-bold"></label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="Số nhà, đường, phường, quận, thành phố"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <!-- ===== PHƯƠNG THỨC THANH TOÁN ===== -->
<div class="mb-3">
    <label class="form-label fw-bold">Phương thức thanh toán <span class="text-danger">*</span></label>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="payment-option border rounded p-3">
                <input type="radio" id="PaymentMethod_COD" name="PaymentMethod" value="COD" checked />
                <label for="PaymentMethod_COD" class="ms-2 fw-bold">
                    <i class="fas fa-money-bill-wave text-success"></i> COD
                    <br />
                    <small class="text-muted fw-normal">Thanh toán khi nhận hàng</small>
                </label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="payment-option border rounded p-3">
                <input type="radio" id="PaymentMethod_Bank" name="PaymentMethod" value="BankTransfer" />
                <label for="PaymentMethod_Bank" class="ms-2 fw-bold">
                    <i class="fas fa-university text-primary"></i> Chuyển khoản
                    <br />
                    <small class="text-muted fw-normal">Chuyển khoản ngân hàng</small>
                </label>
            </div>
        </div>
    </div>
    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
</div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm cho đơn hàng..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2">
                            <i class="fas fa-check-circle"></i> Xác nhận đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn</h5>
                </div>
                <div class="card-body">
                    @if (!cart.Any())
                    {
                        <p class="text-muted">Giỏ hàng trống.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Số lượng</th>
                                        <th>Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cart)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" class="text-end fw-bold">Tổng cộng:</td>
                                        <td class="text-danger fw-bold">@total.ToString("N0") đ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-option {
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .payment-option:hover {
        border-color: #0d6efd !important;
        background-color: #f8f9fa !important;
    }
    .payment-option input[type="radio"] {
        transform: scale(1.2);
        margin-right: 5px;
    }
    .payment-option.border-primary {
        border-width: 2px !important;
        background-color: #e7f1ff !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}