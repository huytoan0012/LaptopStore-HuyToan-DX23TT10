@model List<LaptopStore.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-history"></i> Lịch sử đơn hàng</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag" style="font-size: 60px; color: #ddd;"></i>
            <h3 class="mt-3">Chưa có đơn hàng nào</h3>
            <p class="text-muted">Bạn chưa đặt hàng lần nào. Hãy mua sắm ngay!</p>
            <a href="/" class="btn btn-primary">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><strong>#@order.Id</strong></span>
                            <span class="badge bg-@(order.Status == "Pending" ? "warning" : 
                                                   order.Status == "Processing" ? "info" : 
                                                   order.Status == "Shipped" ? "primary" : 
                                                   order.Status == "Completed" ? "success" : "secondary")">
                                @(order.Status == "Pending" ? "Đang xử lý" :
                                  order.Status == "Processing" ? "Đang chuẩn bị" :
                                  order.Status == "Shipped" ? "Đang giao hàng" :
                                  order.Status == "Completed" ? "Hoàn thành" : "Đã hủy")
                            </span>
                        </div>
                        <div class="card-body">
                            <p>
                                <strong>Ngày đặt:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")<br />
                                <strong>Địa chỉ:</strong> @order.ShippingAddress<br />
                                <strong>Số sản phẩm:</strong> @(order.OrderDetails?.Sum(od => od.Quantity) ?? 0)<br />
                                <strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@order.TotalAmount.ToString("N0") đ</span>
                            </p>
                            <a href="/Order/OrderSuccess/@order.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>