@model LaptopStore.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg border-0">
        <div class="card-body p-5">
            <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
            <h2 class="mt-3">🎉 Đặt hàng thành công!</h2>
            <p class="text-muted">Cảm ơn bạn đã mua hàng tại LaptopStore.</p>

            <div class="alert alert-info d-inline-block">
                <strong>Mã đơn hàng:</strong> #@Model.Id
            </div>

            <div class="row mt-4 text-start">
                <div class="col-md-6">
                    <h5>Thông tin nhận hàng</h5>
                    <p>
                        <strong>Người nhận:</strong> @Model.RecipientName<br />
                        <strong>SĐT:</strong> @Model.PhoneNumber<br />
                        <strong>Địa chỉ:</strong> @Model.ShippingAddress
                    </p>
                </div>
                <div class="col-md-6">
                    <h5>Chi tiết đơn hàng</h5>
                    <p>
                        <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")<br />
                        <strong>Trạng thái:</strong> <span class="badge bg-warning">Đang xử lý</span><br />
                        <strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span>
                    </p>
                </div>
            </div>

            <div class="mt-4">
                <a href="/" class="btn btn-primary">Tiếp tục mua sắm</a>
                <a href="/Order/History" class="btn btn-outline-secondary">Xem lịch sử đơn hàng</a>
            </div>
        </div>
    </div>
</div>