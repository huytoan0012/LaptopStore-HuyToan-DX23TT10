@model LaptopStore.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.jpg" : Model.ImageUrl)" 
                     class="card-img-top p-3" alt="@Model.Name"
                     style="height: 400px; object-fit: contain;" />
            </div>
        </div>

        <div class="col-md-7">
            <h1 class="display-6 fw-bold">@Model.Name</h1>
            
            <div class="mb-2">
                <span class="text-muted">Thương hiệu:</span>
                <span class="fw-bold">@Model.Brand?.Name</span>
            </div>

            <div class="mb-3">
                <span class="badge bg-@(Model.StockQuantity > 0 ? "success" : "danger") fs-6">
                    @(Model.StockQuantity > 0 ? $"Còn {Model.StockQuantity} sản phẩm" : "Hết hàng")
                </span>
            </div>

            <h2 class="text-danger display-5 fw-bold">
                @Model.Price.ToString("N0") <span class="fs-6">đ</span>
            </h2>

            <hr />

            <div class="mt-3">
                <h5>📝 Mô tả sản phẩm</h5>
                <p class="text-muted">@Model.Description</p>
            </div>

            <div class="mt-3">
                <h5>⚙️ Thông số kỹ thuật</h5>
                <div class="p-3 bg-light rounded">
                    @if (!string.IsNullOrEmpty(Model.Specs))
                    {
                        var specs = Model.Specs.Split('|');
                        <ul class="list-unstyled mb-0">
                            @foreach (var spec in specs)
                            {
                                <li><i class="fas fa-check-circle text-success me-2"></i>@spec.Trim()</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có thông tin chi tiết</p>
                    }
                </div>
            </div>

            <div class="mt-4">
                @if (Model.StockQuantity > 0)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="input-group" style="width: 130px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()">-</button>
                            <input type="number" id="quantity" class="form-control text-center" value="1" min="1" max="@Model.StockQuantity" />
                            <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity()">+</button>
                        </div>
                        <form asp-action="AddToCart" asp-controller="Cart" method="post" class="flex-grow-1">
    <input type="hidden" name="productId" value="@Model.Id" />
    <input type="hidden" name="quantity" id="cartQuantity" value="1" />
    <button type="submit" class="btn btn-success btn-lg w-100">
        <i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng
    </button>
</form>
                    </div>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg" disabled>
                        <i class="fas fa-times-circle"></i> Hết hàng
                    </button>
                }
                
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg mt-2 w-100">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    @if (ViewBag.RelatedProducts != null && ((List<LaptopStore

.Models.Product>)ViewBag.RelatedProducts).Any())
    {
        <section class="mt-5">
            <h3 class="mb-4">🔄 Sản phẩm cùng thương hiệu @Model.Brand?.Name</h3>
            <div class="row">
                @foreach (var product in ViewBag.RelatedProducts)
                {
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card h-100 shadow-sm product-card">
                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.jpg" : product.ImageUrl)" 
                                 class="card-img-top" alt="@product.Name"
                                 style="height: 150px; object-fit: contain; padding: 10px;" />
                            <div class="card-body">
                                <h6 class="card-title text-truncate">@product.Name</h6>
                                <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") đ</p>
                                <a href="/Products/Details/@product.Id" class="btn btn-primary btn-sm w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

<script>
    function decreaseQuantity() {
    var input = document.getElementById('quantity');
    var cartInput = document.getElementById('cartQuantity');
    var currentValue = parseInt(input.value);
    if (currentValue > 1) {
        input.value = currentValue - 1;
        cartInput.value = currentValue - 1;
    }
}

function increaseQuantity() {
    var input = document.getElementById('quantity');
    var cartInput = document.getElementById('cartQuantity');
    var currentValue = parseInt(input.value);
    var maxValue = parseInt(input.max);
    if (currentValue < maxValue) {
        input.value = currentValue + 1;
        cartInput.value = currentValue + 1;
    }
}

    function addToCart(productId) {
        var quantity = document.getElementById('quantity').value;
        alert('Đã thêm ' + quantity + ' sản phẩm vào giỏ hàng! (Chức năng sẽ được xây dựng ở bước sau)');
    }
</script>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
    .input-group .btn {
        border-radius: 0;
    }
    .input-group .form-control {
        border-radius: 0;
    }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>