@model List<LaptopStore.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var brands = ViewBag.Brands as List<LaptopStore.Models.Brand>;
    var selectedBrand = ViewBag.SelectedBrand as LaptopStore.Models.Brand;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Sản phẩm</li>
            @if (selectedBrand != null)
            {
                <li class="breadcrumb-item active">@selectedBrand.Name</li>
            }
        </ol>
    </nav>

    <div class="row">
        <!-- Sidebar: Bộ lọc thương hiệu -->
        <div class="col-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-filter"></i> Thương hiệu</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item @(selectedBrand == null ? "active" : "")">
                            <a href="/Products" class="text-decoration-none d-block @(selectedBrand == null ? "text-white" : "")">
                                <i class="fas fa-list"></i> Tất cả sản phẩm
                            </a>
                        </li>
                        @foreach (var brand in brands)
                        {
                            <li class="list-group-item @(selectedBrand?.Id == brand.Id ? "active" : "")">
                                <a href="/Products?brandId=@brand.Id" class="text-decoration-none d-block @(selectedBrand?.Id == brand.Id ? "text-white" : "")">
                                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                    {
                                        <img src="@brand.LogoUrl" alt="@brand.Name" style="height: 20px; margin-right: 8px;" />
                                    }
                                    @brand.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-md-9">
            @if (selectedBrand != null)
            {
                <h3 class="mb-3">
                    <i class="fas fa-laptop"></i> Sản phẩm @selectedBrand.Name
                </h3>
            }
            else
            {
                <h3 class="mb-3"><i class="fas fa-laptop"></i> Tất cả sản phẩm</h3>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="fas fa-info-circle" style="font-size: 40px;"></i>
                    <h4 class="mt-2">Không có sản phẩm nào!</h4>
                    <p class="text-muted">Hiện tại chưa có sản phẩm nào thuộc thương hiệu này.</p>
                    <a href="/Products" class="btn btn-primary">Xem tất cả sản phẩm</a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var product in Model)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                            <div class="card product-card h-100" onclick="location.href='/Products/Details/@product.Id'" style="cursor: pointer;">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.jpg" : product.ImageUrl)" 
                                     class="card-img-top" alt="@product.Name"
                                     style="height: 180px; object-fit: contain; padding: 10px; background: #f8f9fa;" />
                                <div class="card-body">
                                    <h6 class="card-title text-truncate fw-bold">@product.Name</h6>
                                    <p class="card-text text-muted small">@product.Brand?.Name</p>

                                    <!-- Chip thông số -->
                                    @if (!string.IsNullOrEmpty(product.Specs))
                                    {
                                        var specs = product.Specs.Split('|');
                                        <div class="mb-2">
                                            @foreach (var spec in specs.Take(2))
                                            {
                                                <span class="badge bg-light text-dark border me-1 mb-1 p-1 small">
                                                    @spec.Trim()
                                                </span>
                                            }
                                        </div>
                                    }

                                    <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") đ</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-success">Còn @product.StockQuantity sp</span>
                                        <a href="/Products/Details/@product.Id" class="btn btn-primary btn-sm">Xem</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
        border: none;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }
    .list-group-item.active {
        background-color: #4e73df;
        border-color: #4e73df;
    }
    .list-group-item.active a {
        color: white !important;
    }
    .list-group-item a {
        color: #333;
        text-decoration: none;
    }
    .list-group-item a:hover {
        color: #4e73df;
    }
    .list-group-item.active a:hover {
        color: white !important;
    }
</style>