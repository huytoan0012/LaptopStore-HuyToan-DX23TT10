@model List<LaptopStore

.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Quản lý người dùng</h1>
        <span class="badge bg-primary fs-6">Tổng: @Model.Count người dùng</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="userTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Email</th>
                            <th>Tên đăng nhập</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Chưa có người dùng nào.</td>
                            </tr>
                        }
                        else
                        {
                            var stt = 1;
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>
                                        <strong>@user.Email</strong>
                                        @if (!user.EmailConfirmed)
                                        {
                                            <span class="badge bg-warning ms-1" title="Chưa xác nhận email">⚠️</span>
                                        }
                                    </td>
                                    <td>@user.UserName</td>
                                    <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "Chưa cập nhật" : user.PhoneNumber)</td>
                                    <td>
                                        @if (user.IsAdmin)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-crown"></i> Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">User</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@user.StatusColor">@user.Status</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            @if (user.IsLockedOut)
                                            {
                                                <form asp-action="Unlock" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn mở khóa tài khoản này?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-success" title="Mở khóa">
                                                        <i class="fas fa-unlock"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Lock" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn khóa tài khoản này?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-warning" title="Khóa tài khoản">
                                                        <i class="fas fa-lock"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (!user.IsAdmin)
                                            {
                                                <a asp-action="MakeAdmin" asp-route-id="@user.Id" class="btn btn-danger" title="Gán quyền Admin" onclick="return confirm('Bạn có chắc muốn gán quyền Admin cho tài khoản này?')">
                                                    <i class="fas fa-crown"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="RemoveAdmin" asp-route-id="@user.Id" class="btn btn-secondary" title="Xóa quyền Admin" onclick="return confirm('Bạn có chắc muốn xóa quyền Admin của tài khoản này?')">
                                                    <i class="fas fa-user"></i>
                                                </a>
                                            }

                                            @if (!user.IsAdmin)
                                            {
                                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản @user.Email?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-danger" title="Xóa tài khoản">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>